generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                  Int       @id @default(1)
  fullName            String
  title               String
  department          String
  institution         String
  email               String
  officeLocation      String
  officeHours         String
  bio                 String
  photoUrl            String    @default("")
  cvUrl               String    @default("")
  navbarPhotoUrl      String    @default("")
  heroPhotoUrl        String    @default("")
  aboutPhotoUrl       String    @default("")
  contactPhotoUrl     String    @default("")
  footerPhotoUrl      String    @default("")
  adminPhotoUrl       String    @default("")
  academicProfiles    Json
  vision              String?
  mission             String?
  skills              Json?
  languages           Json?
  education           Json?
  workExperience      Json?
  certifications      Json?
  memberships         Json?
  videoIntroUrl       String?
  whatsapp            String?
  mapEmbedUrl         String?
  buildingImageUrl    String?
  faq                 Json?
  leadershipPositions Json?
  mediaAppearances    Json?
  emergencyContact    String?
  autoSyncEnabled     Boolean   @default(true)
  lastSyncAt          DateTime?
  updatedAt           DateTime  @updatedAt
}

model ConnectedAccount {
  id           String    @id @default(cuid())
  platform     String
  accountId    String
  accessToken  String?
  refreshToken String?
  apiKey       String?
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?
  syncStatus   String    @default("pending")
  syncError    String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([platform, accountId])
  @@index([platform, isActive])
}

model SyncedContent {
  id            String    @id @default(cuid())
  platform      String
  externalId    String
  contentType   String
  title         String
  content       String
  metadata      Json
  authors       String[]
  publishedDate DateTime?
  citations     Int       @default(0)
  url           String?
  importedToDb  Boolean   @default(false)
  lastFetchedAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([platform, externalId])
  @@index([platform, contentType])
  @@index([importedToDb])
}

model Publication {
  id         String          @id @default(uuid())
  title      String
  authors    Json
  venue      String
  year       Int
  type       PublicationType
  doi        String?
  url        String?
  abstract   String?
  pdfUrl     String?
  coverImage String?
  published  Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model ResearchProject {
  id             String        @id @default(uuid())
  slug           String        @unique
  title          String
  description    String
  status         ProjectStatus
  startYear      Int
  endYear        Int?
  fundingSources Json?
  collaborators  Json?
  externalUrl    String?
  imageUrl       String?
  teamMembers    Json?
  githubUrl      String?
  documents      Json?
  milestones     Json?
  tags           Json?
  published      Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Course {
  id           String       @id @default(uuid())
  name         String
  code         String
  term         String
  status       CourseStatus
  syllabusUrl  String?
  externalUrl  String?
  description  String?
  bannerImage  String?
  zoomUrl      String?
  classroomUrl String?
  schedule     Json?
  materials    Json?
  published    Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Student {
  id              String        @id @default(uuid())
  name            String
  degreeLevel     DegreeLevel
  researchTopic   String
  status          StudentStatus
  thesisTitle     String?
  graduationYear  Int?
  currentPosition String?
  profileUrl      String?
  photoUrl        String?
  achievements    Json?
  published       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Award {
  id            String        @id @default(uuid())
  name          String
  organization  String
  year          Int
  category      AwardCategory
  amount        String?
  fundingPeriod String?
  description   String?
  imageUrl      String?
  published     Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model BlogPost {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  publishedAt   DateTime
  excerpt       String
  content       String
  tags          Json?
  featuredImage String?
  draft         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

model BlogComment {
  id        String   @id @default(uuid())
  postId    String
  name      String
  email     String
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Event {
  id              String   @id @default(uuid())
  name            String
  date            DateTime
  location        String
  description     String
  externalUrl     String?
  posterImage     String?
  registrationUrl String?
  streamUrl       String?
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Collaborator {
  id          String           @id @default(uuid())
  name        String
  institution String
  area        String
  profileUrl  String?
  logoUrl     String?
  type        CollaboratorType
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Resource {
  id           String   @id @default(uuid())
  title        String
  description  String
  url          String
  category     String
  iconUrl      String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  downloads    Int      @default(0)
  featured     Boolean  @default(false)
  fileSize     String?
  fileUrl      String?
  tags         String[] @default([])
  thumbnailUrl String?
  type         String?
  views        Int      @default(0)

  @@index([category, published])
  @@index([featured])
}

model GalleryItem {
  id        String   @id @default(uuid())
  imageUrl  String
  alt       String
  caption   String
  category  String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id             Int       @id @default(1)
  username       String    @unique
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
}

model SiteSettings {
  id                     Int      @id @default(1)
  siteTitle              String
  tagline                String?
  footerText             String
  contactEmail           String
  maintenanceMode        Boolean  @default(false)
  maintenanceMsg         String?
  socialLinks            Json
  hiddenSections         Json
  heroVideoUrl           String?
  heroImageUrl           String?
  navigationSettings     Json?
  showAnnouncements      Boolean  @default(true)
  showStats              Boolean  @default(true)
  showNewsSlider         Boolean  @default(true)
  showUpcomingEvents     Boolean  @default(true)
  showPublications       Boolean  @default(true)
  showTestimonials       Boolean  @default(true)
  showResearchHighlights Boolean  @default(true)
  showAchievements       Boolean  @default(true)
  showQuickLinks         Boolean  @default(true)
  heroTitle              String?
  heroSubtitle           String?
  heroCTAText            String?
  heroCTALink            String?
  updatedAt              DateTime @updatedAt
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  message    String
  read       Boolean  @default(false)
  receivedAt DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  section     String
  itemId      String?
  itemTitle   String?
  performedBy String
  performedAt DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  content     String
  photoUrl    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  featured    Boolean  @default(false)
  institution String?
  rating      Int      @default(5)

  @@index([featured, published])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  link      String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  date      DateTime
  timeSlot  String
  purpose   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model CourseMaterial {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  type      String
  url       String?
  content   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentMilestone {
  id          String    @id @default(uuid())
  studentId   String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model CollaborationRequest {
  id          String   @id @default(uuid())
  name        String
  email       String
  institution String
  area        String
  message     String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model PageView {
  id        String   @id @default(uuid())
  path      String
  viewedAt  DateTime @default(now())
  userAgent String?
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model ResearchDataset {
  id          String   @id @default(uuid())
  title       String
  description String
  url         String?
  fileUrl     String?
  format      String?
  size        String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ResearchPresentation {
  id          String   @id @default(uuid())
  title       String
  event       String
  date        DateTime
  slideUrl    String?
  videoUrl    String?
  description String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StudentFeedback {
  id        String   @id @default(uuid())
  courseId  String
  rating    Int
  comment   String?
  anonymous Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CourseAttendance {
  id          String   @id @default(uuid())
  courseId    String
  studentName String
  date        DateTime
  present     Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
}

model CourseGrade {
  id          String   @id @default(uuid())
  courseId    String
  studentName String
  assessment  String
  score       Float
  maxScore    Float    @default(100)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminNotification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model StudentNotification {
  id        String   @id @default(uuid())
  studentId String
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BackupLog {
  id        String   @id @default(uuid())
  filename  String
  size      String?
  status    String   @default("completed")
  createdAt DateTime @default(now())
}

model SecurityLog {
  id        String   @id @default(uuid())
  event     String
  username  String?
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())
}

model ResourceAnalytics {
  id         String   @id @default(uuid())
  resourceId String
  views      Int      @default(0)
  downloads  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model ResearchProposal {
  id          String    @id @default(uuid())
  title       String
  description String
  status      String    @default("draft")
  fundingBody String?
  amount      String?
  deadline    DateTime?
  submittedAt DateTime?
  notes       String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ResearchRepository {
  id          String   @id @default(uuid())
  title       String
  description String
  repoUrl     String?
  demoUrl     String?
  language    String?
  stars       Int      @default(0)
  tags        Json?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourseForum {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  content   String
  author    String
  pinned    Boolean  @default(false)
  replies   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseRegistration {
  id          String   @id @default(uuid())
  courseId    String
  studentName String
  email       String
  phone       String?
  status      String   @default("pending")
  notes       String?
  createdAt   DateTime @default(now())
}

model CourseFeedback {
  id        String   @id @default(uuid())
  courseId  String
  rating    Int
  comment   String?
  anonymous Boolean  @default(true)
  createdAt DateTime @default(now())
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  role         String
  email        String?
  photoUrl     String?
  bio          String?
  researchArea String?
  joinedYear   Int?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WebhookIntegration {
  id         String    @id @default(uuid())
  name       String
  url        String
  events     Json
  secret     String?
  active     Boolean   @default(true)
  lastCalled DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model StudentUser {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  studentId      String    @unique
  photoUrl       String?
  enrollmentYear Int
  program        String?
  active         Boolean   @default(true)
  lastLogin      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model StudentEnrollment {
  id          String    @id @default(uuid())
  studentId   String
  courseId    String
  status      String    @default("active")
  grade       String?
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String
  dueDate     DateTime
  maxScore    Float    @default(100)
  fileUrl     String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssignmentSubmission {
  id           String    @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  content      String?
  score        Float?
  feedback     String?
  submittedAt  DateTime  @default(now())
  gradedAt     DateTime?
  late         Boolean   @default(false)
}

model StudentMessage {
  id      String   @id @default(uuid())
  fromId  String
  toId    String
  subject String
  content String
  read    Boolean  @default(false)
  sentAt  DateTime @default(now())
}

model Researcher {
  id            String   @id @default(uuid())
  userId        String?  @unique
  name          String
  email         String   @unique
  institution   String
  department    String?
  researchAreas Json
  h_index       Int?
  citations     Int?
  publications  Int?
  profileUrl    String?
  photoUrl      String?
  bio           String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CollaborationProposal {
  id            String    @id @default(uuid())
  proposerId    String
  title         String
  description   String
  researchArea  String
  fundingNeeded Boolean   @default(false)
  estimatedCost String?
  duration      String?
  status        String    @default("open")
  deadline      DateTime?
  interestedIds Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ResearchMatch {
  id            String   @id @default(uuid())
  researcher1Id String
  researcher2Id String
  matchScore    Float
  commonAreas   Json
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

model CoAuthorshipNetwork {
  id          String   @id @default(uuid())
  researcher1 String
  researcher2 String
  papersCount Int      @default(1)
  lastPaper   DateTime
  createdAt   DateTime @default(now())
}

model CitationMetric {
  id            String   @id @default(uuid())
  publicationId String   @unique
  citations     Int      @default(0)
  downloads     Int      @default(0)
  views         Int      @default(0)
  altmetric     Float?
  hIndex        Int?
  lastSynced    DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model ImpactHistory {
  id        String   @id @default(uuid())
  date      DateTime
  citations Int      @default(0)
  hIndex    Int      @default(0)
  i10Index  Int      @default(0)
  createdAt DateTime @default(now())
}

model PublicationDownload {
  id            String   @id @default(uuid())
  publicationId String
  country       String?
  city          String?
  downloadedAt  DateTime @default(now())
}

model AvailabilitySlot {
  id        String   @id @default(uuid())
  dayOfWeek Int
  startTime String
  endTime   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Appointment {
  id         String   @id @default(uuid())
  studentId  String?
  guestName  String?
  guestEmail String?
  date       DateTime
  startTime  String
  endTime    String
  purpose    String
  status     String   @default("pending")
  zoomUrl    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AppointmentReminder {
  id            String   @id @default(uuid())
  appointmentId String
  sentAt        DateTime @default(now())
  type          String
  sent          Boolean  @default(false)
}

model VideoLecture {
  id           String   @id @default(uuid())
  courseId     String
  title        String
  description  String?
  videoUrl     String
  duration     Int?
  transcript   String?
  thumbnailUrl String?
  chapters     Json?
  published    Boolean  @default(false)
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VideoProgress {
  id           String   @id @default(uuid())
  videoId      String
  studentId    String
  progress     Float    @default(0)
  lastPosition Int      @default(0)
  completed    Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model VideoComment {
  id        String   @id @default(uuid())
  videoId   String
  studentId String
  content   String
  timestamp Int?
  createdAt DateTime @default(now())
}

model VideoPlaylist {
  id          String   @id @default(uuid())
  title       String
  description String?
  courseId    String?
  videoIds    Json
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PeerReview {
  id           String    @id @default(uuid())
  submissionId String
  reviewerId   String
  rubric       Json
  comments     String?
  strengths    String?
  improvements String?
  score        Float?
  anonymous    Boolean   @default(true)
  submitted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  submittedAt  DateTime?
}

model ReviewRubric {
  id           String   @id @default(uuid())
  assignmentId String
  criteria     Json
  createdAt    DateTime @default(now())
}

model PlagiarismCheck {
  id           String   @id @default(uuid())
  submissionId String
  score        Float
  matches      Json?
  checkedAt    DateTime @default(now())
  service      String?
}

model Alumni {
  id              String   @id @default(uuid())
  studentUserId   String?  @unique
  name            String
  email           String   @unique
  graduationYear  Int
  degree          String
  currentCompany  String?
  currentPosition String?
  location        String?
  photoUrl        String?
  linkedin        String?
  achievements    Json?
  willingToMentor Boolean  @default(false)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AlumniStory {
  id        String   @id @default(uuid())
  alumniId  String
  title     String
  story     String
  imageUrl  String?
  featured  Boolean  @default(false)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobPosting {
  id           String    @id @default(uuid())
  postedBy     String
  title        String
  company      String
  location     String
  type         String
  description  String
  requirements String?
  salary       String?
  applyUrl     String?
  active       Boolean   @default(true)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
}

model MentorshipRequest {
  id        String   @id @default(uuid())
  menteeId  String
  mentorId  String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  goals     String?
}

model AlumniEvent {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  location    String
  type        String
  rsvpUrl     String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model FundingOpportunity {
  id           String   @id @default(uuid())
  title        String
  organization String
  amount       String
  deadline     DateTime
  eligibility  String?
  focus        String?
  url          String?
  status       String   @default("open")
  notified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GrantApplication {
  id              String    @id @default(uuid())
  opportunityId   String?
  title           String
  piName          String
  coInvestigators Json?
  amount          String
  deadline        DateTime?
  status          String    @default("draft")
  submittedAt     DateTime?
  decisionDate    DateTime?
  documents       Json?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GrantBudget {
  id            String   @id @default(uuid())
  applicationId String
  items         Json
  totalAmount   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ResearchData {
  id          String   @id @default(uuid())
  projectId   String?
  title       String
  description String?
  dataUrl     String
  format      String?
  size        String?
  accessLevel String   @default("private")
  doi         String?
  version     String   @default("1.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LabNotebook {
  id          String   @id @default(uuid())
  projectId   String?
  date        DateTime @default(now())
  title       String
  content     String
  tags        Json?
  attachments Json?
  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experiment {
  id          String   @id @default(uuid())
  notebookId  String?
  title       String
  hypothesis  String?
  methodology String?
  results     String?
  conclusions String?
  dataFiles   Json?
  status      String   @default("planning")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EquipmentBooking {
  id        String   @id @default(uuid())
  equipment String
  userId    String
  startTime DateTime
  endTime   DateTime
  purpose   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model LivePoll {
  id        String   @id @default(uuid())
  courseId  String?
  question  String
  options   Json
  type      String   @default("multiple_choice")
  active    Boolean  @default(false)
  anonymous Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PollResponse {
  id          String   @id @default(uuid())
  pollId      String
  studentId   String?
  answer      String
  respondedAt DateTime @default(now())
}

model Quiz {
  id             String    @id @default(uuid())
  courseId       String
  title          String
  description    String?
  timeLimit      Int?
  passingScore   Float     @default(70)
  questions      Json
  published      Boolean   @default(false)
  availableFrom  DateTime?
  availableUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String
  studentId   String
  answers     Json
  score       Float
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  timeSpent   Int?
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String
  question      String
  type          String
  options       Json?
  correctAnswer String
  points        Float   @default(1)
  explanation   String?
  order         Int     @default(0)
}

model StudentPoints {
  id        String   @id @default(uuid())
  studentId String   @unique
  points    Int      @default(0)
  level     Int      @default(1)
  rank      String?
  updatedAt DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  description String
  icon        String?
  points      Int      @default(10)
  category    String?
  rarity      String   @default("common")
  criteria    Json?
  createdAt   DateTime @default(now())
}

model StudentAchievement {
  id            String   @id @default(uuid())
  studentId     String
  achievementId String
  earnedAt      DateTime @default(now())
  progress      Int?
}

model Leaderboard {
  id        String   @id @default(uuid())
  courseId  String?
  type      String
  period    String
  data      Json
  updatedAt DateTime @updatedAt
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String
  points      Int      @default(50)
  difficulty  String   @default("medium")
  startDate   DateTime
  endDate     DateTime
  criteria    Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ChallengeProgress {
  id          String    @id @default(uuid())
  challengeId String
  studentId   String
  progress    Float     @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String?
  sessionId String
  messages  Json
  context   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AITrainingData {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DocumentSummary {
  id          String   @id @default(uuid())
  documentUrl String
  summary     String
  keywords    Json?
  generatedAt DateTime @default(now())
}

model Certificate {
  id               String   @id @default(uuid())
  studentId        String
  courseId         String?
  type             String
  title            String
  description      String?
  issueDate        DateTime @default(now())
  certificateUrl   String
  verificationCode String   @unique
  blockchainHash   String?
  createdAt        DateTime @default(now())
}

model CertificateTemplate {
  id          String   @id @default(uuid())
  name        String
  htmlContent String
  cssContent  String?
  variables   Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CertificateVerification {
  id              String   @id @default(uuid())
  certificateId   String
  verifiedAt      DateTime @default(now())
  verifierIp      String?
  verifierCountry String?
}

model MarketplaceItem {
  id           String   @id @default(uuid())
  sellerId     String
  title        String
  description  String
  category     String
  price        Float    @default(0)
  fileUrl      String
  previewUrl   String?
  thumbnailUrl String?
  downloads    Int      @default(0)
  rating       Float?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketplacePurchase {
  id          String   @id @default(uuid())
  itemId      String
  buyerId     String
  amount      Float
  paymentId   String?
  status      String   @default("completed")
  purchasedAt DateTime @default(now())
}

model MarketplaceReview {
  id        String   @id @default(uuid())
  itemId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model SellerProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  displayName String
  bio         String?
  earnings    Float    @default(0)
  rating      Float?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Translation {
  id        String   @id @default(uuid())
  key       String
  language  String
  value     String
  category  String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, language])
}

model ContentTranslation {
  id               String   @id @default(uuid())
  contentType      String
  contentId        String
  language         String
  translatedFields Json
  status           String   @default("draft")
  translatedBy     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([contentType, contentId, language])
}

model Integration {
  id        String    @id @default(uuid())
  name      String
  type      String
  config    Json
  active    Boolean   @default(false)
  lastSync  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model SyncLog {
  id            String   @id @default(uuid())
  integrationId String
  syncType      String
  status        String
  itemsSync     Int?
  errorMessage  String?
  syncedAt      DateTime @default(now())
}

model OAuthToken {
  id           String    @id @default(uuid())
  userId       String
  provider     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model NewsletterCampaign {
  id           String    @id @default(uuid())
  subject      String
  content      String
  templateId   String?
  status       String    @default("draft")
  scheduledFor DateTime?
  sentAt       DateTime?
  recipients   Int?
  opens        Int       @default(0)
  clicks       Int       @default(0)
  createdAt    DateTime  @default(now())
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  htmlContent String
  variables   Json?
  category    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailLog {
  id         String    @id @default(uuid())
  to         String
  subject    String
  status     String
  campaignId String?
  sentAt     DateTime  @default(now())
  openedAt   DateTime?
  error      String?
}

model SMSNotification {
  id        String    @id @default(uuid())
  to        String
  message   String
  status    String    @default("pending")
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())
}

model AccessibilityPreference {
  id            String   @id @default(uuid())
  userId        String   @unique
  highContrast  Boolean  @default(false)
  fontSize      String   @default("medium")
  screenReader  Boolean  @default(false)
  dyslexiaFont  Boolean  @default(false)
  reducedMotion Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model MediaAltText {
  id        String   @id @default(uuid())
  mediaUrl  String   @unique
  altText   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MobileDevice {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String   @unique
  platform   String
  pushToken  String?
  appVersion String?
  lastActive DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model PushNotification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  data      Json?
  status    String    @default("pending")
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model OfflineSync {
  id       String   @id @default(uuid())
  userId   String
  dataType String
  data     Json
  syncedAt DateTime @default(now())
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String
  userId     String?
  sessionId  String?
  properties Json?
  timestamp  DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  country    String?
}

model StudentEngagement {
  id        String   @id @default(uuid())
  studentId String
  courseId  String?
  metric    String
  value     Float
  period    String
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([studentId, metric, period, date])
}

model PredictiveAnalytic {
  id           String   @id @default(uuid())
  studentId    String
  riskScore    Float
  factors      Json
  suggestions  Json?
  calculatedAt DateTime @default(now())
}

model ABTest {
  id          String   @id @default(uuid())
  name        String
  description String?
  variants    Json
  metrics     Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NavigationMenu {
  id           String           @id @default(uuid())
  label        String
  href         String?
  icon         String?
  description  String?
  order        Int              @default(0)
  parentId     String?
  isVisible    Boolean          @default(true)
  openInNewTab Boolean          @default(false)
  requiresAuth Boolean          @default(false)
  badge        String?
  badgeColor   String?
  isMegaMenu   Boolean          @default(false)
  columns      Int?             @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  parent       NavigationMenu?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationMenu[] @relation("MenuHierarchy")

  @@index([parentId])
  @@index([order])
}

model CommunityPost {
  id          String           @id @default(uuid())
  title       String
  content     String
  authorName  String
  authorEmail String?
  category    String
  tags        String[]
  imageUrl    String?
  likes       Int              @default(0)
  views       Int              @default(0)
  isPinned    Boolean          @default(false)
  isApproved  Boolean          @default(false)
  published   Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  replies     CommunityReply[]

  @@index([category, published])
  @@index([isPinned, isApproved])
}

model CommunityReply {
  id          String        @id @default(uuid())
  postId      String
  authorName  String
  authorEmail String?
  content     String
  likes       Int           @default(0)
  isApproved  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model FAQ {
  id         String   @id @default(uuid())
  question   String
  answer     String
  category   String
  order      Int      @default(0)
  helpful    Int      @default(0)
  notHelpful Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category, published])
  @@index([order])
}

enum PublicationType {
  journal
  conference
  book
  book_chapter
  technical_report
  other
}

enum ProjectStatus {
  active
  completed
}

enum CourseStatus {
  active
  archived
}

enum DegreeLevel {
  PhD
  Masters
}

enum StudentStatus {
  current
  alumni
}

enum AwardCategory {
  award
  grant
  fellowship
  honor
  distinction
}

enum CollaboratorType {
  individual
  institution
}
